PORT=3005
DATABASE_URL="postgresql://config_service:config_service_dev@localhost:5432/chatvardage_config?schema=public"

# Origines autorisées par CORS, séparées par des virgules.
# Défaut si absente : http://localhost:5173 (serveur de dev du Frontend).
CORS_ORIGINS=http://localhost:5173

# Secret partagé entre microservices : exigé avec x-user-id (posé par
# Serveur-API) et sur /api/internal/* (Authentification). Même valeur que
# dans l'Infra ; au moins 32 caractères en production.
INTERNAL_SERVICE_TOKEN=chatvardage_internal_dev
